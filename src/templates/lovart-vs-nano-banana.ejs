<%# input: static comparison evidence and build helpers from build.js %>
<%# output: /lovart-vs-nano-banana independent comparison page %>
<%# pos: Comparisons child page under /lovart-alternative (update this comment and src/README.md when changing file role) %>
<%
const pageSeo = {
    title: 'Lovart vs Nano Banana: Verified, Reported, and Unclear',
    description: 'Compare Lovart and Nano Banana claims with conservative evidence labels, route status, and notes on what remains unverified.',
    keywords: ''
};
const breadcrumbItems = [
    { name: t.nav.home, href: link('/') },
    { name: 'Lovart Alternatives', href: link('/lovart-alternative') },
    { name: 'Lovart vs Nano Banana', href: canonicalUrl }
];
const comparisonRows = [
    ['Primary role', 'AI design agent for multi-asset creative work.', 'Visual editing or image-model workflow, pending official product evidence.'],
    ['Best use case', 'Brand kits, product visuals, campaign concepts, ad assets.', 'Image edits, visual variations, and reference-driven experiments.'],
    ['Brand consistency', 'Official Lovart pages describe style consistency across iterations.', 'Treat consistency claims as pending unless verified from an official source.'],
    ['Image editing', 'Lovart official pages describe targeted edits and text edits.', 'Useful if your source confirms editing behavior for your current tool access.'],
    ['Video assets', 'Lovart has official video generator pages and campaign video examples.', 'Do not assume video generation unless the current Nano Banana source confirms it.'],
    ['Pricing and access', 'Check Lovart official pricing and account state before client work.', 'Check the current access route, provider, and quota before use.']
];
%>
<!DOCTYPE html>
<html lang="<%= lang %>" class="scroll-smooth">
<head>
    <%- include('partials/head', { pageSeo }) %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageSeo.title %></title>
    <meta name="description" content="<%= pageSeo.description %>">
    <meta name="keywords" content="">
    <link rel="canonical" href="<%= canonicalUrl %>">
    <%- include('partials/hreflang') %>
    <link rel="stylesheet" href="/styles.css">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <%- include('partials/analytics') %>
    <%- include('partials/schema-breadcrumb', { breadcrumbItems }) %>
</head>
<body class="bg-neutral-light text-neutral-dark antialiased">
<%- include('partials/header') %>
<%- include('partials/breadcrumb', { breadcrumbItems }) %>
<main>
    <section class="bg-white py-16 lg:py-24 border-b border-neutral/10">
        <div class="container mx-auto px-6 max-w-5xl">
            <p class="text-sm uppercase tracking-wide text-primary font-semibold mb-4">Independent comparison</p>
            <h1 class="text-4xl md:text-5xl font-bold text-neutral-dark mb-5">Lovart vs Nano Banana: AI Design Agent or Visual Editing Workflow?</h1>
            <p class="text-lg text-neutral leading-relaxed max-w-3xl">Lovart is best evaluated as a multi-asset design agent. Nano Banana should be evaluated only from the current source you can verify, because social demos and video titles do not prove ownership, pricing, model version, or availability.</p>
            <div class="mt-8 bg-amber-50 border border-amber-200 rounded-lg p-5 text-amber-900">
                <strong>Evidence boundary:</strong> Lovart product claims here come from official Lovart pages. Nano Banana claims without an official source stay marked as pending.
                <span class="block mt-2 text-sm font-semibold">Last checked: 2026-07-14</span>
            </div>
        </div>
    </section>

    <section class="py-16 bg-neutral-light/40">
        <div class="container mx-auto px-6 max-w-5xl">
            <h2 class="text-3xl font-bold text-neutral-dark mb-6">Route Status</h2>
            <p class="text-neutral leading-relaxed mb-6">The 2026-07-14 report says the live route may return 404, while this local repository contains the template and build mapping for this page. Treat that as disputed until the deployed site is checked after build.</p>
            <div class="overflow-x-auto rounded-lg border border-neutral/10 bg-white">
                <table class="w-full text-left">
                    <thead class="bg-neutral-light">
                        <tr><th class="p-4">Surface</th><th class="p-4">Status</th><th class="p-4">Evidence label</th><th class="p-4">Safe next step</th></tr>
                    </thead>
                    <tbody class="divide-y divide-neutral/10">
                        <tr><td class="p-4 font-semibold">Local template</td><td class="p-4">src/templates/lovart-vs-nano-banana.ejs exists</td><td class="p-4 font-semibold text-green-700">verified</td><td class="p-4">Build the static output.</td></tr>
                        <tr><td class="p-4 font-semibold">Sitemap after build</td><td class="p-4">Must include /lovart-vs-nano-banana</td><td class="p-4 font-semibold text-green-700">verified after build</td><td class="p-4">Check dist/sitemap.xml.</td></tr>
                        <tr><td class="p-4 font-semibold">Live route</td><td class="p-4">Report says 404, local code says route exists</td><td class="p-4 font-semibold text-red-700">disputed</td><td class="p-4">Use HTTP checks to confirm deployment.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="py-16 bg-neutral-light/40">
        <div class="container mx-auto px-6 max-w-6xl">
            <h2 class="text-3xl font-bold text-neutral-dark mb-8">Quick Verdict</h2>
            <div class="grid md:grid-cols-2 gap-6">
                <article class="bg-white border border-neutral/10 rounded-lg p-6">
                    <h3 class="text-xl font-bold mb-3">Choose Lovart if...</h3>
                    <p class="text-neutral leading-relaxed">You need one brief to produce related visual assets: brand direction, product visuals, social concepts, and campaign-ready creative variations.</p>
                </article>
                <article class="bg-white border border-neutral/10 rounded-lg p-6">
                    <h3 class="text-xl font-bold mb-3">Choose Nano Banana if...</h3>
                    <p class="text-neutral leading-relaxed">Your verified access path supports the specific image editing or visual variation task you need. Treat demos as inspiration, not proof.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="py-16 bg-white">
        <div class="container mx-auto px-6 max-w-6xl">
            <h2 class="text-3xl font-bold text-neutral-dark mb-8">What Lovart Adds</h2>
            <p class="text-neutral leading-relaxed mb-6">Lovart adds a broader creative workflow: prompt intake, brand direction, related asset generation, and campaign context. Treat these as verified only where official Lovart pages describe them.</p>
            <div class="overflow-x-auto rounded-lg border border-neutral/10">
