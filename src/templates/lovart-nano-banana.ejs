<%# input: build helpers from build.js %>
<%# output: /lovart-nano-banana support page with evidence boundaries %>
<%# pos: Support page for Nano Banana intent; direct comparison lives at /lovart-vs-nano-banana %>
<%
const pageSeo = {
    title: 'Lovart Nano Banana Support Notes',
    description: 'Evidence-bounded notes for Lovart Nano Banana search intent, with the direct comparison routed to Lovart vs Nano Banana.',
    keywords: ''
};
const breadcrumbItems = [
    { name: t.nav.home, href: link('/') },
    { name: 'Lovart Nano Banana', href: canonicalUrl }
];
const statusRows = [
    ['Direct comparison intent', 'Use /lovart-vs-nano-banana as the canonical comparison guide.', 'verified'],
    ['Nano Banana ownership or provider', 'Not asserted on this page without a current official source.', 'pending'],
    ['Lovart account access or plan limits', 'Check official Lovart account and pricing screens before relying on access claims.', 'pending'],
    ['Third-party demos and videos', 'Useful as search-intent signals only, not product proof.', 'reported'],
    ['Hidden endpoints, leaked prompts, or bypasses', 'Do not use or publish them.', 'unsafe']
];
%>
<!DOCTYPE html>
<html lang="<%= lang %>" class="scroll-smooth">
<head>
    <%- include('partials/head', { pageSeo }) %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageSeo.title %></title>
    <meta name="description" content="<%= pageSeo.description %>">
    <meta name="keywords" content="">
    <link rel="canonical" href="<%= canonicalUrl %>">
    <%- include('partials/hreflang') %>
    <link rel="stylesheet" href="/styles.css">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <%- include('partials/analytics') %>
    <%- include('partials/schema-breadcrumb', { breadcrumbItems }) %>
</head>
<body class="bg-neutral-light text-neutral-dark antialiased">
<%- include('partials/header') %>
<%- include('partials/breadcrumb', { breadcrumbItems }) %>
<main>
    <section class="bg-white py-16 lg:py-24 border-b border-neutral/10">
        <div class="container mx-auto px-6 max-w-5xl">
            <p class="text-sm uppercase tracking-wide text-primary font-semibold mb-4">Support page</p>
            <h1 class="text-4xl md:text-5xl font-bold text-neutral-dark mb-5">Lovart Nano Banana Support Notes</h1>
            <p class="text-lg text-neutral leading-relaxed max-w-3xl">This page is kept for Lovart Nano Banana search intent, but it does not assert provider ownership, model access, pricing, quota, or performance without official confirmation.</p>
            <div class="mt-8 bg-amber-50 border border-amber-200 rounded-lg p-5 text-amber-900">
                <p class="font-semibold mb-2">Comparison intent note</p>
                <p class="leading-relaxed">For the direct comparison, use <a href="<%= link('/lovart-vs-nano-banana') %>" class="text-primary font-semibold">Lovart vs Nano Banana</a>. That page is the canonical comparison guide.</p>
            </div>
        </div>
    </section>

    <section class="py-16">
        <div class="container mx-auto px-6 max-w-5xl">
            <h2 class="text-3xl font-bold text-neutral-dark mb-6">Evidence Status</h2>
            <p class="text-sm font-semibold uppercase tracking-wide text-neutral mb-5">Last checked: 2026-07-14</p>
            <div class="overflow-x-auto rounded-lg border border-neutral/10 bg-white">
                <table class="w-full text-left">
                    <thead class="bg-neutral-light">
                        <tr><th class="p-4">Claim</th><th class="p-4">How to treat it</th><th class="p-4">Label</th></tr>
                    </thead>
                    <tbody class="divide-y divide-neutral/10">
                        <% statusRows.forEach(function(row) { %>
                        <tr><td class="p-4 font-semibold"><%= row[0] %></td><td class="p-4 text-neutral"><%= row[1] %></td><td class="p-4 font-semibold"><%= row[2] %></td></tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="py-16 bg-white">
        <div class="container mx-auto px-6 max-w-5xl">
            <h2 class="text-3xl font-bold text-neutral-dark mb-8">Next Pages</h2>
            <div class="grid md:grid-cols-3 gap-5">
                <a href="<%= link('/lovart-vs-nano-banana') %>" class="block rounded-lg border border-neutral/10 p-5 hover:border-primary transition">
                    <h3 class="font-bold mb-2">Lovart vs Nano Banana</h3>
                    <p class="text-sm text-neutral">Use this for the direct comparison query.</p>
                </a>
                <a href="<%= link('/lovart-alternative') %>" class="block rounded-lg border border-neutral/10 p-5 hover:border-primary transition">
                    <h3 class="font-bold mb-2">Lovart Alternatives</h3>
                    <p class="text-sm text-neutral">Compare alternative workflows without absolute ranking claims.</p>
                </a>
                <a href="<%= link('/lovart-prompt-library') %>" class="block rounded-lg border border-neutral/10 p-5 hover:border-primary transition">
                    <h3 class="font-bold mb-2">Lovart Prompt Library</h3>
                    <p class="text-sm text-neutral">Use copy-ready prompt examples with evidence limits.</p>
                </a>
            </div>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
</body>
</html>
