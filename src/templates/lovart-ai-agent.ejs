<!DOCTYPE html>
<%
const page = t.lovart_ai_agent_page;
const breadcrumbItems = [{ name: t.nav.home, href: link('/') }, { name: page.seo.title, href: canonicalUrl }];
%>
<html lang="<%= lang %>" class="scroll-smooth">

<head>
    <%- include('partials/head', { pageSeo: page.seo }) %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= page.seo.title %></title>
    <meta name="description" content="<%= page.seo.description %>">
    <meta name="keywords" content="">
    <link rel="canonical" href="<%= canonicalUrl %>">
    <%- include('partials/hreflang') %>
    <link rel="stylesheet" href="/styles.css">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <%- include('partials/analytics') %>
    <%- include('partials/schema-breadcrumb', { breadcrumbItems }) %>
    <%- include('partials/schema-faq', { faqItems: page.faq.items }) %>
</head>

<body class="bg-neutral-light text-neutral-dark antialiased">
    <%- include('partials/header') %>
    <%- include('partials/breadcrumb', { breadcrumbItems }) %>

    <main>
        <section class="bg-gradient-to-b from-primary/10 to-transparent py-20 lg:py-28">
            <div class="container mx-auto px-6 text-center max-w-4xl">
                <span class="inline-block py-1 px-3 rounded-full bg-primary/10 text-primary text-sm font-semibold mb-6">
                    <%= page.hero.badge %>
                </span>
                <h1 class="text-4xl md:text-5xl font-bold mb-6 text-neutral-dark"><%= page.hero.title %></h1>
                <p class="text-xl text-neutral mb-8"><%= page.hero.subtitle %></p>
                <div class="flex flex-col sm:flex-row justify-center gap-4 mb-10">
                    <a href="<%= link('/lovart-tutorial') %>"
                        class="btn-primary px-8 py-4 text-lg rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                        <%= page.hero.cta_primary %>
                    </a>
                    <a href="<%= link('/lovart-design-features') %>"
                        class="btn-secondary px-8 py-4 text-lg rounded-xl font-semibold border-2 border-primary/20 hover:border-primary/50 transition-all duration-300">
                        <%= page.hero.cta_secondary %>
                    </a>
                </div>
                <p class="text-left text-neutral leading-relaxed bg-white rounded-xl p-6 border border-neutral/10">
                    <%= page.hero.content %>
                </p>
            </div>
        </section>

        <section class="container mx-auto px-6 py-6">
            <%- include('partials/adsense', { format: 'horizontal', minHeight: '90px' }) %>
        </section>

        <section class="py-16 bg-white">
            <div class="container mx-auto px-6 max-w-5xl">
                <h2 class="text-3xl font-bold text-neutral-dark mb-6"><%= page.comparison.heading %></h2>
                <div class="overflow-hidden rounded-xl shadow border border-neutral/10">
                    <table class="min-w-full divide-y divide-neutral/10 text-left bg-white">
                        <thead class="bg-neutral-light">
                            <tr>
                                <th class="px-6 py-4 font-semibold text-neutral-dark">Dimension</th>
                                <th class="px-6 py-4 font-semibold text-primary">AI Agent</th>
                                <th class="px-6 py-4 font-semibold text-neutral/80">Basic Generator</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-neutral/10">
                            <% page.comparison.rows.forEach(function(row) { %>
                                <tr class="hover:bg-neutral-light/50">
                                    <td class="px-6 py-4 font-medium text-neutral-dark"><%= row.aspect %></td>
                                    <td class="px-6 py-4 text-neutral-dark"><%= row.agent %></td>
                                    <td class="px-6 py-4 text-neutral"><%= row.generator %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <p class="text-sm text-neutral/80 mt-6">
                    Hub links:
                    <a href="<%= link('/') %>" class="text-primary hover:text-primary-dark font-medium">Home</a> ·
                    <a href="<%= link('/about') %>" class="text-primary hover:text-primary-dark font-medium">About</a> ·
                    <a href="<%= link('/blog') %>" class="text-primary hover:text-primary-dark font-medium">Blog</a> ·
                    <a href="<%= link('/lovart-pricing') %>"
                        class="text-primary hover:text-primary-dark font-medium">Pricing</a>
                </p>
            </div>
        </section>

        <section class="container mx-auto px-6 py-6">
            <%- include('partials/adsense') %>
        </section>

        <section class="py-16">
            <div class="container mx-auto px-6 max-w-6xl">
                <h2 class="text-3xl font-bold text-neutral-dark mb-8"><%= page.use_cases.heading %></h2>
                <div class="grid md:grid-cols-3 gap-8">
                    <% page.use_cases.items.forEach(function(item) { %>
                        <div class="bg-white rounded-2xl p-8 border border-neutral/10 shadow-sm">
                            <h3 class="text-xl font-bold text-neutral-dark mb-3"><%= item.title %></h3>
                            <p class="text-neutral leading-relaxed"><%= item.desc %></p>
                        </div>
                    <% }); %>
                </div>
            </div>
        </section>

        <section class="container mx-auto px-6 py-6">
            <%- include('partials/adsense') %>
        </section>

        <section class="py-16 bg-white border-y border-neutral/10">
            <div class="container mx-auto px-6 max-w-5xl">
                <h2 class="text-3xl font-bold text-neutral-dark mb-6">What an AI Design Agent Does</h2>
                <p class="text-neutral leading-relaxed mb-8">
                    An AI design agent turns a brief into a multi-step creative workflow. For Lovart, official documentation describes a design agent that can help with product shots, social posts, marketing campaign kits, brand videos, model selection, asset generation, and AI-assisted editing. This page does not claim Lovart is the only AI design agent.
                </p>
                <div class="grid md:grid-cols-5 gap-4">
                    <div class="bg-neutral-light rounded-xl p-5"><h3 class="font-bold mb-2">Brief</h3><p class="text-sm text-neutral">Start with goal, audience, asset type, and constraints.</p></div>
                    <div class="bg-neutral-light rounded-xl p-5"><h3 class="font-bold mb-2">Route</h3><p class="text-sm text-neutral">Choose a suitable model or creative path.</p></div>
                    <div class="bg-neutral-light rounded-xl p-5"><h3 class="font-bold mb-2">Generate</h3><p class="text-sm text-neutral">Create images, layouts, or campaign assets.</p></div>
                    <div class="bg-neutral-light rounded-xl p-5"><h3 class="font-bold mb-2">Edit</h3><p class="text-sm text-neutral">Refine text, composition, and style direction.</p></div>
                    <div class="bg-neutral-light rounded-xl p-5"><h3 class="font-bold mb-2">Export</h3><p class="text-sm text-neutral">Prepare usable creative files when plan and feature access allow.</p></div>
                </div>
            </div>
        </section>

        <section id="github" class="py-16 bg-neutral-light">
            <div class="container mx-auto px-6 max-w-5xl">
                <h2 class="text-3xl font-bold text-neutral-dark mb-6">AI Design Agent Free and GitHub Checks</h2>
                <p class="text-neutral leading-relaxed mb-6">AI design agent free and AI design agent GitHub are category-level searches, not proof that a Lovart free tier or official repository exists. Use them as routing signals, then verify on official product, pricing, and developer pages.</p>
                <div class="grid md:grid-cols-3 gap-5">
                    <a href="<%= link('/lovart-free') %>" class="block bg-white rounded-xl p-5 border border-neutral/10"><h3 class="font-bold mb-2">Free access</h3><p class="text-sm text-neutral">Check credits, watermark, login, and commercial rights before relying on free use.</p></a>
                    <a href="<%= link('/lovart-developer-options#github') %>" class="block bg-white rounded-xl p-5 border border-neutral/10"><h3 class="font-bold mb-2">GitHub intent</h3><p class="text-sm text-neutral">Community repositories stay reported until an official source links them.</p></a>
                    <a href="<%= link('/lovart-api-documentation') %>" class="block bg-white rounded-xl p-5 border border-neutral/10"><h3 class="font-bold mb-2">Developer access</h3><p class="text-sm text-neutral">Use API documentation notes for verified, pending, and unsafe developer claims.</p></a>
                </div>
            </div>
        </section>

        <section id="skill-api" class="py-16 bg-white border-y border-neutral/10">
            <div class="container mx-auto px-6 max-w-5xl">
                <h2 class="text-3xl font-bold text-neutral-dark mb-4">Lovart Skill, Agent, and API Boundary</h2>
                <p class="text-neutral leading-relaxed mb-6">A skill can describe a reusable workflow, while an agent describes a multi-step task pattern. Neither term proves a public Lovart API, SDK, or self-serve key.</p>
                <div class="overflow-x-auto rounded-xl border border-neutral/10">
                    <table class="min-w-full bg-white text-left text-sm">
                        <thead class="bg-neutral-light"><tr><th class="px-6 py-4">Claim</th><th class="px-6 py-4">Evidence label</th><th class="px-6 py-4">Safe next step</th></tr></thead>
                        <tbody class="divide-y divide-neutral/10">
                            <tr><td class="px-6 py-4 font-medium">Lovart Skill API is publicly documented</td><td class="px-6 py-4 text-amber-700 font-semibold">pending</td><td class="px-6 py-4">Check the <a href="<%= link('/lovart-api-documentation#skill-api') %>" class="text-primary font-semibold">API documentation guide</a>; do not assume an endpoint exists.</td></tr>
                            <tr><td class="px-6 py-4 font-medium">Skill or GitHub examples are official</td><td class="px-6 py-4 text-orange-700 font-semibold">reported</td><td class="px-6 py-4">Treat community examples as research leads until Lovart links them from an official source.</td></tr>
                            <tr><td class="px-6 py-4 font-medium">Private endpoints or generated access codes</td><td class="px-6 py-4 text-red-700 font-semibold">unsafe</td><td class="px-6 py-4">Do not publish guessed URLs, headers, private routes, or generated codes.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section id="free-options" class="py-16">
            <div class="container mx-auto px-6 max-w-5xl">
                <h2 class="text-3xl font-bold text-neutral-dark mb-6">AI Design Agent vs Image Generator</h2>
                <div class="overflow-x-auto rounded-xl border border-neutral/10">
                    <table class="min-w-full bg-white text-left">
                        <thead class="bg-neutral-light">
                            <tr><th class="px-6 py-4">Question</th><th class="px-6 py-4 text-primary">AI design agent</th><th class="px-6 py-4">Image generator</th></tr>
                        </thead>
                        <tbody class="divide-y divide-neutral/10">
                            <tr><td class="px-6 py-4 font-medium">Main output</td><td class="px-6 py-4">Connected creative assets and workflow decisions.</td><td class="px-6 py-4">One or more images from a prompt.</td></tr>
                            <tr><td class="px-6 py-4 font-medium">Best task</td><td class="px-6 py-4">Brand kits, campaign assets, product visuals, ad concepts.</td><td class="px-6 py-4">Quick image drafts and style exploration.</td></tr>
                            <tr><td class="px-6 py-4 font-medium">Iteration</td><td class="px-6 py-4">Adjusts direction across related outputs.</td><td class="px-6 py-4">Usually re-prompts isolated images.</td></tr>
                            <tr><td class="px-6 py-4 font-medium">Free status</td><td class="px-6 py-4">Check official access and plan limits.</td><td class="px-6 py-4">Check credit, watermark, and license rules.</td></tr>
                            <tr><td class="px-6 py-4 font-medium">Risk</td><td class="px-6 py-4">Can be over-described as replacing designers.</td><td class="px-6 py-4">Can be mistaken for full production workflow.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="py-16 bg-white border-y border-neutral/10">
            <div class="container mx-auto px-6 max-w-5xl">
                <h2 class="text-3xl font-bold text-neutral-dark mb-8 text-center">Video Walkthroughs</h2>
                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <div class="aspect-video rounded-xl overflow-hidden border border-neutral/10 bg-neutral-light">
                            <iframe class="w-full h-full" src="https://www.youtube-nocookie.com/embed/714vC3pmGew" title="AI design agent walkthrough video" loading="lazy" allowfullscreen></iframe>
                        </div>
                        <p class="text-sm text-neutral mt-3">Fallback link: <a href="https://www.youtube.com/watch?v=714vC3pmGew" target="_blank" rel="noopener noreferrer" class="text-primary font-semibold">watch on YouTube</a>. Video is a visual reference, not feature proof.</p>
                    </div>
                    <div>
                        <div class="aspect-video rounded-xl overflow-hidden border border-neutral/10 bg-neutral-light">
                            <iframe class="w-full h-full" src="https://www.youtube-nocookie.com/embed/5xA1tuUP6Sk" title="Lovart AI review walkthrough video" loading="lazy" allowfullscreen></iframe>
                        </div>
                        <p class="text-sm text-neutral mt-3">Fallback link: <a href="https://www.youtube.com/watch?v=5xA1tuUP6Sk" target="_blank" rel="noopener noreferrer" class="text-primary font-semibold">watch on YouTube</a>. Treat opinions as reported, not verified.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-16 bg-white border-y border-neutral/10">
            <div class="container mx-auto px-6 max-w-4xl">
                <h2 class="text-3xl font-bold text-neutral-dark mb-8 text-center"><%= page.faq.heading %></h2>
                <div class="space-y-5">
                    <% page.faq.items.forEach(function(item) { %>
                        <div class="bg-neutral-light rounded-xl p-6 border border-neutral/10">
                            <h3 class="font-semibold text-neutral-dark mb-2"><%= item.q %></h3>
                            <p class="text-neutral leading-relaxed"><%= item.a %></p>
                        </div>
                    <% }); %>
                </div>
            </div>
        </section>

        <section class="py-12 bg-white border-b border-neutral/10">
            <div class="container mx-auto px-6 max-w-4xl">
                <h2 class="text-2xl font-bold text-neutral-dark mb-6"><%= page.related.heading %></h2>
                <ul class="space-y-4">
                    <% page.related.items.forEach(function(item) { %>
                        <li>
                            <a href="<%= link(item.path) %>"
                                class="text-primary hover:text-primary-dark font-medium transition-colors"><%= item.title %></a>
                        </li>
                    <% }); %>
                </ul>
            </div>
        </section>

        <section class="py-12">
            <div class="container mx-auto px-6 max-w-4xl">
                <div class="bg-amber-50 border-l-4 border-amber-400 rounded-r-xl p-6">
                    <h2 class="text-lg font-bold text-amber-900 mb-2"><%= page.disclaimer.title %></h2>
                    <p class="text-amber-800 font-semibold"><%= page.disclaimer.text %></p>
                </div>
            </div>
        </section>

        <section class="container mx-auto px-6 py-6">
            <%- include('partials/adsense', { format: 'horizontal', minHeight: '90px' }) %>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>

</html>
